# ==============================================================================
# University of Chicago — Bursar Payment Gateway Environment Configuration
# ==============================================================================

PORT=3000

# ------------------------------------------------------------------------------
# Domain SMTP Email Configuration for 2FA Authorization Codes
# ------------------------------------------------------------------------------
# The SMTP service sends 6-digit 2FA codes for candidate payment authorization.
# Requirement: The From: address matches the authenticated SMTP login address.
#
# Examples:
# For Hostinger Webmail:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=admissions@uchicago.asia
#   SMTP_PASS=YourEmailPasswordHere
#   SMTP_FROM=admissions@uchicago.asia
#
# For cPanel / Custom Domain:
#   SMTP_HOST=mail.uchicago.asia
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=bursar@uchicago.asia
#   SMTP_PASS=YourEmailPasswordHere
#   SMTP_FROM=bursar@uchicago.asia
# ------------------------------------------------------------------------------

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admissions@uchicago.asia
SMTP_PASS=
SMTP_FROM=admissions@uchicago.asia
